{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@design-system/core": ["./packages/core/src"],
      "@design-system/components": ["./packages/components/src"],
      "@design-system/hooks": ["./packages/hooks/src"],
      "@design-system/utils": ["./packages/utils/src"],
      "@design-system/tenant-config": ["./packages/tenant-config/src"],
      "@design-system/design-system": ["./packages/design-system/src"],
      "@design-system/auth": ["./packages/auth/src"],
      "@design-system/types": ["./packages/types/src"]
    }
  },
  "include": [],
  "exclude": ["node_modules", "dist", "build"]
}
