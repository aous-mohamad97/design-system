{
  "name": "design-system",
  "version": "1.0.0",
  "private": true,
  "description": "Design system monorepo with React, TypeScript, Tailwind CSS, and shadcn/ui",
  "scripts": {
    "dev": "pnpm --filter storybook dev",
    "dev:storybook": "pnpm --filter storybook dev",
    "dev:backend": "pnpm --filter tenant-auth-service start:dev",
    "dev:platform": "pnpm --filter platform-shell dev",
    "dev:claims": "pnpm --filter claims dev",
    "build": "pnpm -r --filter './packages/*' build",
    "build:apps": "pnpm -r --filter './apps/*' build",
    "build:all": "pnpm run build && pnpm run build:apps",
    "build:watch": "pnpm -r --filter './packages/*' build:watch",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "test:backend": "pnpm --filter tenant-auth-service test",
    "test:auth": "pnpm --filter @design-system/auth test",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "@changesets/cli": "^2.27.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "license": "MIT"
}
